# Application
# Optional service identity; default: user-learning (also used in logs and JWKS calls).
SPRING_APPLICATION_NAME=user-learning

# Database — required; no URL or credential defaults.
# JDBC MySQL URL, e.g. jdbc:mysql://db:3306/users; keep credentials in separate variables.
SPRING_DATASOURCE_URL=
# Required database account name and password.
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JPA / Hibernate
# Optional schema action; default: none. Use migrations in production; update is for development.
SPRING_JPA_HIBERNATE_DDL_AUTO=none
# Optional SQL output; default: false. Enabling may expose sensitive query details.
SPRING_JPA_SHOW_SQL=false

# Server
# Optional bind address and TCP port; defaults: 0.0.0.0 and 8080 (port range: 1–65535).
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# Tracing
# Optional sampled fraction, 0.0–1.0; default: 1.0 (all requests).
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# Logging — consumed directly by logback-spring.xml.
# Optional log directory; default: ./logs. Docker image sets /app/data/logs.
APP_LOG_DIR=./logs
# Optional log file basename; default: user-api. Does not set service identity.
APP_NAME=user-api
# Optional root level; default: INFO. Values: TRACE, DEBUG, INFO, WARN, ERROR, OFF.
LOG_LEVEL=INFO

# JWT configuration
# Required public JWKS endpoint URL; use HTTPS outside trusted local networks.
JWT_JWK_SET_URI=http://localhost:8783/api/v1/jwks/user

# JWKS caller identity — optional, self-reported; never include secrets.
# All identity values: 1–64 ASCII letters/digits/dots/underscores/hyphens; start with letter/digit.
# Dynamic default: spring.application.name (SPRING_APPLICATION_NAME, otherwise user-learning).
# JWKS_CALLER_SERVICE=user-learning
# Dynamic default: HOSTNAME, otherwise a generated instance UUID.
# JWKS_CALLER_INSTANCE=user-service-pod-7
# Optional HOSTNAME fallback, normally supplied by the container/platform; otherwise UUID.
# HOSTNAME=user-service-pod-7
# Dynamic build default: Maven project version (currently 0.0.1-SNAPSHOT).
# JWKS_CALLER_VERSION=1.2.3

# Required exact trusted JWT issuer; must match issued tokens. No default.
JWT_ISSUER=
# Optional access-token lifetime in seconds; default: 900. Use a positive integer.
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Optional refresh-token lifetime in days; default: 30. Use a positive integer.
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Signing keys — required first key; only private keys owned by this service.
# Required unique key ID; must match the public key's kid in JWKS.
APP_SECURITY_SIGNING_KEYS_0_KID=
# Required readable path to a PKCS#8 RSA private PEM file (BEGIN PRIVATE KEY).
APP_SECURITY_SIGNING_KEYS_0_PRIVATEKEYPATH=
# Required boolean (true/false); exactly one configured key must be true.
APP_SECURITY_SIGNING_KEYS_0_ACTIVE=
# Optional additional keys: repeat APP_SECURITY_SIGNING_KEYS_<index>_KID,
# _PRIVATEKEYPATH and _ACTIVE for consecutive indices 1, 2, ... .
# Each additional key requires an ID/path; its ACTIVE defaults to false via property binding.

# OTLP metrics
# Optional metrics export switch; default: false. Enabling requires collector configuration.
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false

# Internal service authentication (standalone process URLs, not Docker DNS).
INTERNAL_JWT_JWK_SET_URI=http://localhost:8783/api/v1/jwks/learning
INTERNAL_JWT_ISSUER=learning-service
INTERNAL_JWT_SUBJECT=learning-service
INTERNAL_JWT_AUDIENCE=user-service
INTERNAL_JWT_CLOCK_SKEW=5s
INTERNAL_JWT_MAX_LIFETIME=300s
